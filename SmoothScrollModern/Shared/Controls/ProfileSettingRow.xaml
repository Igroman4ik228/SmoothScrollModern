<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SmoothScrollModern.Shared.Controls.ProfileSettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Root">

    <Grid
        Padding="0,8,0,10"
        ColumnSpacing="18"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="172" />
        </Grid.ColumnDefinitions>

        <StackPanel Spacing="2">
            <TextBlock FontWeight="SemiBold" Text="{Binding Label, ElementName=Root}" />
            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Description, ElementName=Root}" />
        </StackPanel>

        <Grid
            Grid.Column="1"
            VerticalAlignment="Center"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <NumberBox
                x:Name="ValueBox"
                AcceptsExpression="False"
                AutomationProperties.Name="{Binding Label, ElementName=Root}"
                Maximum="{Binding Maximum, ElementName=Root}"
                Minimum="{Binding Minimum, ElementName=Root}"
                SmallChange="{Binding SmallChange, ElementName=Root}"
                Style="{StaticResource CompactNumberBoxStyle}"
                ValueChanged="OnValueBoxValueChanged"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay}" />

            <TextBlock
                Grid.Column="1"
                MinWidth="28"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextStyle}"
                Text="{Binding Unit, ElementName=Root}" />
        </Grid>

        <Slider
            Grid.Row="1"
            Grid.ColumnSpan="2"
            MinHeight="32"
            AutomationProperties.Name="{Binding Label, ElementName=Root}"
            Maximum="{Binding Maximum, ElementName=Root}"
            Minimum="{Binding Minimum, ElementName=Root}"
            SmallChange="{Binding StepFrequency, ElementName=Root}"
            StepFrequency="{Binding StepFrequency, ElementName=Root}"
            Style="{StaticResource ProfileSliderStyle}"
            Value="{Binding Value, ElementName=Root, Mode=TwoWay}" />
    </Grid>
</UserControl>
