<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SmoothScrollModern.Widgets.Applications.ApplicationRulesListBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:applications="using:SmoothScrollModern.Features.Applications.Controls"
    xmlns:sharedControls="using:SmoothScrollModern.Shared.Controls">

    <Border Style="{StaticResource SurfacePanelStyle}">
        <StackPanel Spacing="14">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Приложения" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Добавляйте приложения для исключений, отдельных профилей или режима выбранных приложений." />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    MinWidth="76"
                    Padding="10,5"
                    VerticalAlignment="Top"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding ProfileCountText}" />
                </Border>
            </Grid>

            <AutoSuggestBox
                AutomationProperties.Name="Поиск приложений"
                PlaceholderText="Поиск по названию, процессу или пути"
                QueryIcon="Find"
                Text="{Binding ApplicationSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <sharedControls:ListEmptyState
                Description="Добавьте приложение, которое нужно исключить, настроить отдельно или выбрать для плавной прокрутки."
                State="EmptyList"
                Visibility="{Binding IsApplicationRulesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <sharedControls:ListEmptyState
                Description="Проверьте название приложения, имя процесса или путь к файлу и попробуйте другой запрос."
                State="SearchNoResults"
                Visibility="{Binding IsApplicationRuleSearchEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <ListView
                MaxHeight="620"
                HorizontalContentAlignment="Stretch"
                ItemContainerStyle="{StaticResource BorderlessListViewItemStyle}"
                ItemsSource="{Binding FilteredApplicationRules}"
                SelectionMode="None"
                Style="{StaticResource BorderlessListViewStyle}"
                Visibility="{Binding HasVisibleApplicationRules, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <applications:ApplicationRuleItem />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Visibility="{Binding HasApplicationRulesPagination, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="{Binding ApplicationRulesPageText}" />
                <PipsPager
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    MaxVisiblePips="7"
                    NextButtonVisibility="Visible"
                    NumberOfPages="{Binding ApplicationRulesPageCount}"
                    PreviousButtonVisibility="Visible"
                    SelectedPageIndex="{Binding ApplicationRulesPageIndex, Mode=TwoWay}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
