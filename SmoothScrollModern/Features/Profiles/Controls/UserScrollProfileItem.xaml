<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SmoothScrollModern.Features.Profiles.Controls.UserScrollProfileItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    x:Name="Root"
    HorizontalAlignment="Stretch">

    <toolkit:SettingsExpander
        HorizontalAlignment="Stretch"
        Margin="0,0,0,8"
        Expanded="OnProfileExpanderExpanded"
        IsExpanded="{Binding AreSettingsVisible, ElementName=Root, Mode=TwoWay}">
        <toolkit:SettingsExpander.Header>
            <StackPanel Spacing="3">
                <TextBlock
                    FontWeight="SemiBold"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Style="{StaticResource CaptionTextStyle}"
                    Text="{Binding ProfileSummaryText}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </toolkit:SettingsExpander.Header>

        <toolkit:SettingsExpander.Content>
            <Button
                Width="40"
                Height="32"
                MinWidth="40"
                Padding="0"
                AutomationProperties.Name="Удалить профиль прокрутки"
                Click="OnRemoveScrollProfileClick"
                ToolTipService.ToolTip="Удалить профиль">
                <FontIcon Glyph="&#xE74D;" Style="{StaticResource InlineButtonIconStyle}" />
            </Button>
        </toolkit:SettingsExpander.Content>

        <toolkit:SettingsExpander.ItemsHeader>
            <ContentControl
                x:Name="ProfileSettingsHost"
                Margin="0,4,0,0"
                Padding="20,16"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch" />
        </toolkit:SettingsExpander.ItemsHeader>
    </toolkit:SettingsExpander>
</UserControl>
