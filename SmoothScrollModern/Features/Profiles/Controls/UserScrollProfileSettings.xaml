<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SmoothScrollModern.Features.Profiles.Controls.UserScrollProfileSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:profileControls="using:SmoothScrollModern.Features.Profiles.Controls"
    xmlns:sharedControls="using:SmoothScrollModern.Shared.Controls"
    x:Name="Root"
    HorizontalAlignment="Stretch">

    <StackPanel HorizontalAlignment="Stretch" Spacing="16">
        <TextBox
            VerticalContentAlignment="Center"
            AutomationProperties.Name="Название профиля"
            Header="Название профиля"
            PlaceholderText="Например: Браузер"
            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <sharedControls:ProfileSettingRow
            Description="Сколько прокручивать от одного движения колеса."
            FractionDigits="3"
            Label="Сила прокрутки"
            Maximum="10"
            Minimum="0.1"
            SmallChange="0.05"
            StepFrequency="0.05"
            Unit="x"
            Value="{Binding ProfileScrollStrength, Mode=TwoWay}" />

        <sharedControls:ProfileSettingRow
            Description="Как быстро скорость затухает сама по себе."
            FractionDigits="1"
            Label="Трение"
            Maximum="60"
            Minimum="1.5"
            SmallChange="0.1"
            StepFrequency="0.1"
            Unit="1/с"
            Value="{Binding ProfileFriction, Mode=TwoWay}" />

        <sharedControls:ProfileSettingRow
            Description="Насколько сильнее реагировать на быстрые повторные движения колеса."
            Label="Разгон серии"
            Maximum="600"
            Minimum="5"
            SmallChange="5"
            StepFrequency="5"
            Unit="%"
            Value="{Binding ProfileFastScrollBoostPercent, Mode=TwoWay}" />

        <sharedControls:ProfileSettingRow
            Description="Насколько быстро гасить старую инерцию при обратной прокрутке."
            Label="Контроль направления"
            Maximum="98"
            Minimum="0"
            SmallChange="1"
            StepFrequency="1"
            Unit="%"
            Value="{Binding ProfileDirectionControlPercent, Mode=TwoWay}" />

        <sharedControls:ProfileSettingRow
            Description="Ограничивает скорость, чтобы скролл не улетал при сильном вращении."
            Label="Предел скорости"
            Maximum="40000"
            Minimum="500"
            SmallChange="50"
            StepFrequency="50"
            Unit="ед/с"
            Value="{Binding ProfileMaxVelocity, Mode=TwoWay}" />

        <sharedControls:ProfileSettingRow
            Description="Скорость, ниже которой движение считается остановившимся."
            Label="Порог остановки"
            Maximum="120"
            Minimum="1"
            SmallChange="1"
            StepFrequency="1"
            Unit="ед/с"
            Value="{Binding ProfileStopVelocityThreshold, Mode=TwoWay}" />

        <sharedControls:ProfileSettingRow
            Description="Чувствительность к мелким high-resolution wheel delta."
            FractionDigits="3"
            Label="Точное колесо"
            Maximum="3"
            Minimum="0.1"
            SmallChange="0.05"
            StepFrequency="0.05"
            Unit="x"
            Value="{Binding ProfilePrecisionMultiplier, Mode=TwoWay}" />

        <StackPanel Spacing="6">
            <StackPanel Spacing="2">
                <TextBlock FontWeight="SemiBold" Text="Горизонтальная прокрутка" />
            </StackPanel>
            <ToggleSwitch
                AutomationProperties.Name="Горизонтальная прокрутка"
                IsOn="{Binding ProfileEnableHorizontalScroll, Mode=TwoWay}"
                OffContent="Откл."
                OnContent="Вкл." />
        </StackPanel>

        <profileControls:ProfileBypassKeysEditor />
    </StackPanel>
</UserControl>
